{
  "name": "@sarthak1407/react-transliterate",
  "version": "2.3.0",
  "description": "Transliterate component for React with configurable trigger keys and punctuation handling",
  "author": "SarthakSahoo1407",
  "license": "MIT",
  "repository": "sks-srujanee/react-transliterate",
  "types": "dist/index.d.ts",
  "keywords": [
    "react",
    "transliterate",
    "english to hindi",
    "indic",
    "purnaviram"
  ],
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "yarn build",
    "test": "yarn test:unit && yarn test:lint && yarn test:build",
    "test:build": "yarn build",
    "test:lint": "eslint .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "predeploy": "cd example && yarn install && yarn run build",
    "deploy": "gh-pages -d example/dist",
    "dev": "yarn start & cd example && yarn dev"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/textarea-caret": "^3.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "textarea-caret": "^3.1.0"
  },
  "homepage": "https://github.com/sks-srujanee/react-transliterate#readme",
  "bugs": {
    "url": "https://github.com/sks-srujanee/react-transliterate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  }
}
